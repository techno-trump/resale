---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ReSale | 404" description="Page is not found">
	<div class="section-space error-page">
    <div class="container error-page__container">
      <img class="error-page__image" src="img/404.png" alt="404">
  
      <div class="error-page__content">
        <h2 class="tg-h2 error-page__title">Сторінку не знайдено</div>
        <div class="tg-h4 error-page__text">
          Ця сторінка зникла так само,<br />
          як і твій старий стиль 👀
        </div>
        <div class="error-page__buttons">
          <a href="/" class="btn btn_primary btn_rect btn_big error-page__nav-button">
            <i class="icon-sign-right error-page__nav-button-icon"></i>
            <span>Повернутись на головну</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>